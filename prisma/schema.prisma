generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role               { CONFECCAO FACCAO ADMIN }
enum UserStatus         { ATIVO SUSPENSO }
enum DemandStatus       { RECEBENDO_PROPOSTAS PAUSADA EM_ANDAMENTO CONCLUIDA ENCERRADA }
enum ProposalStatus     { ENVIADA ACEITA RECUSADA RETIRADA }
enum AgreementStatus    { AGUARDANDO_CONFIRMACAO CONFIRMADO CONCLUIDO }
enum AvailabilityStatus { LIVRE OCUPADO }
enum ReportTarget       { PERFIL DEMANDA AVALIACAO }
enum ReportStatus       { ABERTA PROCEDENTE IMPROCEDENTE }

model User {
  id        String     @id @default(uuid())
  phone     String     @unique
  name      String
  role      Role
  status    UserStatus @default(ATIVO)
  verified  Boolean    @default(false)
  consentAt DateTime
  createdAt DateTime   @default(now())

  confeccao             ConfeccaoProfile?
  faccao                FaccaoProfile?
  demands               Demand[]
  proposals             Proposal[]
  agreementsAsConfeccao Agreement[]    @relation("AgConfeccao")
  agreementsAsFaccao    Agreement[]    @relation("AgFaccao")
  reviewsWritten        Review[]       @relation("ReviewAuthor")
  reviewsReceived       Review[]       @relation("ReviewTarget")
  reports               Report[]       @relation("Reporter")
  notifications         Notification[]
  passwordHash String?
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model ConfeccaoProfile {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  city        String
  description String?
}

model FaccaoProfile {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?
  city           String
  description    String?
  weeklyCapacity Int     @default(0)
  photos         String[]
  services       FaccaoService[]
  availability   AvailabilityPeriod[]
}

model ServiceCategory {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  active  Boolean @default(true)
  demands Demand[]
  faccoes FaccaoService[]
}

model FaccaoService {
  faccaoId   String
  categoryId Int
  faccao     FaccaoProfile   @relation(fields: [faccaoId], references: [userId], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  @@id([faccaoId, categoryId])
}

model AvailabilityPeriod {
  id        String             @id @default(uuid())
  faccaoId  String
  faccao    FaccaoProfile      @relation(fields: [faccaoId], references: [userId], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  status    AvailabilityStatus @default(LIVRE)
}

model DemandCounter {
  year Int @id
  last Int @default(0)
}

model Demand {
  id           String       @id @default(uuid())
  code         String       @unique
  confeccaoId  String
  confeccao    User         @relation(fields: [confeccaoId], references: [id])
  categoryId   Int
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  title        String
  description  String?
  quantity     Int
  deadline     DateTime
  city         String
  photos       String[]
  status       DemandStatus @default(RECEBENDO_PROPOSTAS)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  proposals    Proposal[]
  agreement    Agreement?

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([status, city])
  @@index([status, deadline])
  @@index([confeccaoId, createdAt(sort: Desc)])
}

model Proposal {
  id           String         @id @default(uuid())
  demandId     String
  demand       Demand         @relation(fields: [demandId], references: [id], onDelete: Cascade)
  faccaoId     String
  faccao       User           @relation(fields: [faccaoId], references: [id])
  price        Decimal        @db.Decimal(12, 2)
  deadlineDays Int
  message      String?
  status       ProposalStatus @default(ENVIADA)
  createdAt    DateTime       @default(now())
  agreement    Agreement?

  @@unique([demandId, faccaoId])
}

model Agreement {
  id              String          @id @default(uuid())
  proposalId      String          @unique
  proposal        Proposal        @relation(fields: [proposalId], references: [id])
  demandId        String          @unique
  demand          Demand          @relation(fields: [demandId], references: [id])
  confeccaoId     String
  confeccao       User            @relation("AgConfeccao", fields: [confeccaoId], references: [id])
  faccaoId        String
  faccao          User            @relation("AgFaccao", fields: [faccaoId], references: [id])
  price           Decimal         @db.Decimal(12, 2)
  deadlineDays    Int
  dueDate         DateTime
  status          AgreementStatus @default(AGUARDANDO_CONFIRMACAO)
  confirmedAt     DateTime?
  completedAt     DateTime?
  completedOnTime Boolean?
  reminderSentAt  DateTime?
  createdAt       DateTime        @default(now())
  reviews         Review[]
}

model Review {
  id          String    @id @default(uuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  authorId    String
  author      User      @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    String
  target      User      @relation("ReviewTarget", fields: [targetId], references: [id])
  rating      Int
  comment     String?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([agreementId, authorId])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  targetType   ReportTarget
  targetId     String
  reason       String
  status       ReportStatus @default(ABERTA)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
